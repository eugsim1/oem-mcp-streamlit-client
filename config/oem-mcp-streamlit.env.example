# Streamlit listener. Keep loopback unless an authenticated TLS reverse proxy is in front.
STREAMLIT_ADDRESS=127.0.0.1
STREAMLIT_PORT=8501

# Optional OEM defaults. Leave the password empty to enter it in the GUI only.
OEM_MCP_ENDPOINT=https://oem.example.com:7803/em/api/mcp
OEM_MCP_USERNAME=
OEM_MCP_PASSWORD=
OEM_MCP_PROTOCOL_VERSION=2025-11-25
OEM_MCP_VERIFY_TLS=true
OEM_MCP_CA_BUNDLE=
OEM_MCP_TIMEOUT_SECONDS=60

# Runtime storage. Service installation rewrites these to /var/lib and /var/log.
OEM_MCP_DATA_DIR=./data
OEM_MCP_LOG_DIR=./logs
OEM_MCP_PROFILE_FILE=./data/profiles.json

# Security gates. The safe defaults allow recognized read-only tools and SELECT/WITH SQL only.
OEM_MCP_ALLOW_HTTP=false
OEM_MCP_ALLOW_MUTATING_TOOLS=false
OEM_MCP_ALLOW_NONSELECT_SQL=false
OEM_MCP_REVERSE_PROXY_AUTHENTICATED=false
